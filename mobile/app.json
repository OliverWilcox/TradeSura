{
  "expo": {
    "name": "TradeSura",
    "slug": "tradesura-engineer",
    "scheme": "tradesura",
    "owner": "oliverwilcox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tradesura.engineerx",
      "buildNumber": "22",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.tradesura.engineer",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B1A2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TradeSura uses Face ID to keep your account locked when you're not using it."
        }
      ],
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "TradeSura uses your contacts to import customers into your book."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#0B1A2E"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "To photograph your Gas Safe ID card for verification.",
          "photosPermission": "TradeSura uses your photos to upload your logo and Gas Safe ID card."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 88,
          "resizeMode": "contain",
          "backgroundColor": "#0B1A2E"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8fb104fb-b6f9-4090-acad-190b742ece54"
      }
    }
  }
}
