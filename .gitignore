# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local-only tooling (cloudflared tunnel binary/logs)
.bin/

# Claude Code local state (skill caches, scheduled-task locks) — machine-
# local, not project config
/.agents/
/.claude/
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
!.env.example
lib/generated/

# Build guides, reviews and notes stay on the dev machine, not in the repo
*.md
/docs/
/app/assets/*
!/app/assets/brand/

# Local-only backups (not pushed)
/_local-backup/
