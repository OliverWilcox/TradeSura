generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
}

enum ClauseKind {
  CORE
  ADD
}

// Build Guide v2 Part 7.3/7.4 — a plan is a listing, not a fixed "tier":
// DRAFT (built in the wizard, never offered — deletable), LIVE (offerable,
// counted for gates), STOPPED (was live, now retired — a reversible toggle,
// existing customers untouched). New rows default to DRAFT; only "Make this
// plan live" moves one to LIVE.
enum PlanTierStatus {
  DRAFT
  LIVE
  STOPPED
}

// SAFE ships in the picker; CARE is hidden until solicitor sign-off.
enum ClauseStatus {
  SAFE
  CARE
}

enum ActorType {
  ENGINEER
  CUSTOMER
  SYSTEM
  // A TradeSura staff member acting through the admin API (lib/admin-api).
  ADMIN
}

enum MessageClass {
  TRANSACTIONAL
  MARKETING
}

enum SmsStatus {
  QUEUED
  SENT
  CANCELLED
}

model Engineer {
  id                         String            @id @default(cuid())
  email                      String            @unique
  slug                       String            @unique
  // Review 4 — the engineer picks their address (tradesura.com/{slug}) once
  // at setup; after that renaming the business never moves it. Until then
  // it follows the trading name, and every address it had keeps working.
  slugChosenAt               DateTime?
  previousSlugs              String[]          @default([])
  firstName                  String?
  lastName                   String?
  phone                      String?           @unique // E.164, verified by SMS OTP at signup
  emailVerifiedAt            DateTime?
  smsSignInEnabled           Boolean           @default(false)
  phoneVerifiedAt            DateTime?
  // Installer messages on WhatsApp (lib/whatsapp.ts): Meta needs a recorded
  // opt-in. Null = texts only; a WhatsApp STOP clears it.
  whatsappOptInAt            DateTime?
  // Sign in with Apple's stable user id (the identity token's `sub`), set
  // when the engineer signs up with "Continue with Apple" (30 Sept build
  // notes, step 1 item 5). Apple only sends name/email the first time, so
  // this is what recognises them on every later Apple sign-in.
  appleSub                   String?           @unique
  tradingName                String?
  logoUrl                    String?
  businessType               String? // sole_trader | ltd | partnership
  companyNumber              String?
  // Companies House company_status at signup (active, dissolved, liquidation…).
  // Flagged, never blocking, in the admin verification queue.
  companyStatus              String?
  postcode                   String? // business postcode, not shown to customers
  marketingConsent           Boolean           @default(false)
  // "TradeSura can text me to help me finish setting up" (client feedback,
  // engineer record 2): when they agreed, null if they haven't. Setup texts
  // (the admin's verification chase) need it; sign-in codes and texts about
  // their customers don't.
  setupTextConsentAt         DateTime?
  gasSafeNo                  String?           @unique // review #13 — one licence, one account
  gasSafeName                String?
  gasSafeCompany             String?
  gasSafeCategories          String?
  gasSafeVerifiedAt          DateTime?
  // review #11 — set instead of gasSafeVerifiedAt when the number the
  // engineer entered didn't match our register on signup, so they can
  // continue (manual-review escape hatch) rather than being dead-ended.
  gasSafeReviewRequestedAt   DateTime?
  // 29 Sept review — verification is a human decision, not a register
  // auto-match: signup submits the number + ID-card photo into the admin
  // queue (app/admin/verifications), which sets gasSafeVerifiedAt or
  // gasSafeRejectedAt. Card photo lives in Blob under an unguessable path.
  gasSafeCardUrl             String?
  // The ID card's expiry date, given with the photo (client feedback 3.5,
  // engineer record 4). The next register re-check is due by then.
  gasSafeCardExpiresOn       DateTime?         @db.Date
  gasSafeRejectedAt          DateTime?
  gasSafeRejectReason        String?
  // Build Guide v2 Part 11 — push notifications. Set once the app has asked
  // permission (after the first plan goes live, per spec) and registered a
  // real device token via POST /api/me/push-token. Null means either the
  // engineer hasn't reached that point yet or denied permission — either
  // way, sendPushNotification (lib/push.ts) no-ops rather than erroring, so
  // nothing that fires a push needs to check this first.
  expoPushToken              String?
  stripeAccountId            String?           @unique // Connect Express account (acct_…)
  stripeDetailsSubmitted     Boolean           @default(false)
  stripeChargesEnabled       Boolean           @default(false)
  stripePayoutsEnabled       Boolean           @default(false)
  // First tap on "Continue to Stripe". The account itself is made earlier,
  // when Get paid opens, so it alone doesn't mean the engineer has started.
  stripeOnboardingStartedAt  DateTime?
  // Set when Stripe asks a finished account for more information (Stripe's
  // point 7); the engineer is alerted once per request, cleared when done.
  stripeMoreInfoAlertedAt    DateTime?
  // Build Review 3 §8 account emails (lib/account-emails.ts), each sent once.
  paymentsNudgeEmailAt       DateTime?
  noPlanNudgeEmailAt         DateTime?
  firstCustomerEmailAt       DateTime?
  firstPayoutEmailAt         DateTime?
  // Build Guide v2 Part 6.4 — the standing-strip state machine's two states
  // with no trigger UI yet (no admin tool exists to set these; a human sets
  // them directly for now). The mechanism ships so the priority ladder
  // (banned > paused > ...) is real; ship-now, policy-later per Part 19.
  pausedAt                   DateTime?
  pauseReason                String?
  bannedAt                   DateTime?
  banReason                  String?
  // How the engineer arrived: { heardVia, referralCode?, letterBatch?, variantCell? }
  attribution                Json?
  packAddress                String? // founding-member pack postal address
  // 30 Oct update 3.6 — trading address: EngineerTradingAddress (lib/addresses.ts).
  packRequestedAt            DateTime?
  // Part 17.4 — the pack queues on request but only ships once the badge is
  // live; set from the admin queue's "Packs to post" list when it's posted.
  packShippedAt              DateTime?
  // 2026 Build Guide getting-started steps. Public profile at
  // tradesura.com/{slug}: indexable by search engines once published.
  profileBio                 String?
  serviceArea                String?
  profilePublishedAt         DateTime?
  // Set the first time the website embed loads on a site that isn't ours.
  websiteConnectedAt         DateTime?
  websiteHost                String?
  // First time the engineer shared their invite link from the app.
  inviteSharedAt             DateTime?
  // Build Review 3. Legal name from Companies House (Ltd/partnership) — a
  // blank trading name falls back to it, and customer pages say "X is a
  // trading name of Y" when they differ.
  legalName                  String?
  // "Are you the only owner of the company?" — yes sends the representative
  // to Stripe as owner and director, so those steps disappear.
  soleOwner                  Boolean?
  // R5 — prices are shown "including VAT" on customer pages when set.
  vatRegistered              Boolean           @default(false)
  // R12 — { CLAUSE_CODE: ISO date } for options needing a qualification the
  // engineer confirmed they hold. Shown in the admin verification queue.
  qualificationConfirmations Json?
  // Retention, Home Passport & Growth spec (15 Oct). Public profile at
  // tradesura.com/gas-engineers/{townSlug}/{slug}.
  town                       String?
  townSlug                   String?
  profilePhotos              String[]          @default([])
  showCallButton             Boolean           @default(true)
  showMessageButton          Boolean           @default(true)
  enquiryPhone               String? // the number the profile's Call button rings (E.164)
  widgetDisabledAt           DateTime? // admin switch-off for the website widget
  leftAt                     DateTime? // installer exited TradeSura — customers offered a nearby engineer
  // 30 Oct update §10 — first time the account could take sign-ups (Gas
  // Safe check done, a live plan, payments on). Orders the race for a
  // town's top 3 Founding spots.
  accountCompletedAt         DateTime?
  enquiries                  Enquiry[]
  detailsRequests            DetailsRequest[]
  // 30 Oct update §5 — what the installer normally charges, asked blank in
  // the plan builder. The customer page's "Worth over £X a year" uses only
  // these figures (lib/value-sum.ts), never a guide or benchmark.
  normalServicePence         Int?
  normalCalloutPence         Int?
  repairDiscountPercent      Int?
  ratings                    Rating[]
  serviceRecords             ServiceRecord[]
  stickers                   Sticker[]         @relation("StickerAllocated")
  // E10 — who brought this engineer in, and whether their £50 bounty is paid.
  referrerId                 String?
  referrer                   Engineer?         @relation("Referrals", fields: [referrerId], references: [id])
  referrals                  Engineer[]        @relation("Referrals")
  referralBountyPaidAt       DateTime? // retired flat-£50 scheme; kept for history
  // Build Review 2, section 8 — team accounts. A staff engineer is an Engineer
  // row with ownerId set to the business owner. Staff sign in to their own
  // account but act inside the owner's business: customers, plans and money
  // stay on the owner's row. Removing staff sets staffRemovedAt; access stops
  // on the next request (lib/auth.ts getActor).
  ownerId                    String?
  owner                      Engineer?         @relation("Team", fields: [ownerId], references: [id])
  staff                      Engineer[]        @relation("Team")
  staffRemovedAt             DateTime?
  customersAdded             Customer[]        @relation("CustomerAddedBy")
  plansSold                  Plan[]            @relation("PlanSoldBy")
  deletedAt                  DateTime? // in-app account deletion (App Store 5.1.1); row anonymised
  referralEarnings           ReferralEarning[] @relation("ReferralEarnings")
  referredEarnings           ReferralEarning[] @relation("ReferredEarnings")
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  customers                  Customer[]
  tiers                      PlanTier[]
  plans                      Plan[]

  @@index([previousSlugs], type: Gin)
  townLeadsClaimed           TownLead[]        @relation("TownLeadClaims")
}

model Customer {
  id               String     @id @default(cuid())
  engineerId       String
  engineer         Engineer   @relation(fields: [engineerId], references: [id])
  firstName        String
  lastName         String
  phone            String // normalised E.164
  email            String?
  smsOptOut        Boolean    @default(false)
  stripeCustomerId String?
  source           String     @default("added") // added | doorstep | web | import | contacts
  // Section 8 — the staff engineer who added them (null = the owner).
  addedById        String?
  addedBy          Engineer?  @relation("CustomerAddedBy", fields: [addedById], references: [id])
  createdAt        DateTime   @default(now())
  properties       Property[]
  plans            Plan[]

  @@unique([engineerId, phone])
}

model Property {
  id           String        @id @default(cuid())
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  addressLine1 String
  addressLine2 String?
  town         String?
  postcode     String
  appliances   Appliance[]
  // Section 4 — the home's passport (shared by every plan at this address).
  passportId   String?
  passport     HomePassport? @relation(fields: [passportId], references: [id])
}

model Appliance {
  id             String          @id @default(cuid())
  propertyId     String
  property       Property        @relation(fields: [propertyId], references: [id])
  make           String?
  model          String?
  type           String?
  lastServicedAt DateTime?
  installedAt    DateTime?
  photoUrls      String[]        @default([])
  passportId     String?
  passport       HomePassport?   @relation(fields: [passportId], references: [id])
  records        ServiceRecord[]
}

// Solicitor-approved wording. Seeded; read-only in the app.
model ClauseTemplate {
  id           String       @id @default(cuid())
  code         String       @unique
  title        String
  bodyText     String
  kind         ClauseKind
  status       ClauseStatus @default(SAFE)
  category     String       @default("Core gas servicing")
  // Suggested monthly uplift in pence; null = core, no charge, or engineer-set.
  upliftPence  Int?
  pricingLabel String?
  highlight    Boolean      @default(false)
  // Small print under the title: customer's words / engineer's words.
  note         String?
  engineerNote String?
  sortOrder    Int
  tiers        TierClause[]
}

model PlanTier {
  id                 String         @id @default(cuid())
  engineerId         String
  engineer           Engineer       @relation(fields: [engineerId], references: [id])
  name               String
  priceMonthlyPence  Int
  isRecommended      Boolean        @default(false)
  sortOrder          Int
  status             PlanTierStatus @default(DRAFT)
  // Display-only extras; blocklist-checked; never enter the plan document.
  customLabels       String[]       @default([])
  // Builder Step 4: "I'll provide everything in this plan to every customer
  // on it" — ticked before the plan could go live.
  providerAttestedAt DateTime?
  // R6 — the engineer's rate for "you set the rate" options, { CODE: "10%" }.
  // Required before the plan can go live; shown on the customer's plan page.
  clauseRates        Json?
  clauses            TierClause[]
  plans              Plan[]
}

model TierClause {
  tierId   String
  clauseId String
  tier     PlanTier       @relation(fields: [tierId], references: [id], onDelete: Cascade)
  clause   ClauseTemplate @relation(fields: [clauseId], references: [id])

  @@id([tierId, clauseId])
}

model Plan {
  id                      String          @id @default(cuid())
  ref                     String          @unique
  engineerId              String
  engineer                Engineer        @relation(fields: [engineerId], references: [id])
  customerId              String
  customer                Customer        @relation(fields: [customerId], references: [id])
  tierId                  String?
  tier                    PlanTier?       @relation(fields: [tierId], references: [id])
  // 30 Oct update §6 — why the installer was there (lib/visit-reasons.ts),
  // the content variant the customer saw, and the at-the-job offer it came
  // from, so conversion can be tracked by reason.
  visitReason             String?
  visitVariant            String?
  offerSessionId          String?
  status                  PlanStatus      @default(PENDING)
  priceMonthlyPence       Int?
  signupToken             String          @unique
  portalToken             String          @unique
  linkOpenedAt            DateTime?
  stripeCheckoutSessionId String?
  stripeSubscriptionId    String?
  stripeCustomerId        String?
  mandateStatus           String? // pending | active | inactive
  coolingOffEndsAt        DateTime?
  activatedAt             DateTime?
  cancelledAt             DateTime?
  paymentFailedAt         DateTime? // S2 — set on invoice.payment_failed, cleared on recovery
  termsVersion            String? // review #18 — which CURRENT_TERMS_VERSION (lib/terms.ts) they agreed to
  termsAgreedAt           DateTime?
  // R9 — a Landlord plan: the customer confirmed at checkout the property is let.
  propertyLetConfirmedAt  DateTime?
  // Review 4 — landlord plans with a CP12: when the customer's current gas
  // safety record is due, and whether they asked for a one-off CP12 because
  // it falls before the plan's own record is available (lib/cp12.ts).
  gasSafetyRecordDueAt    DateTime?
  oneOffCp12RequestedAt   DateTime?
  // Section 1 — "month" | "year" (12 months for the price of 11).
  billingInterval         String          @default("month")
  // First collection and all benefits wait for cooling-off; the service
  // start date is the first cleared payment after it.
  serviceStartsAt         DateTime?
  paymentsCleared         Int             @default(0) // the annual service unlocks at 3
  // Section 2 — cancellation at the end of the paid month; pause = no
  // collections, no benefits, restarts automatically.
  cancelRequestedAt       DateTime?
  cancelEffectiveAt       DateTime?
  pausedUntil             DateTime?
  rejoinToken             String?         @unique
  // Section 3 — failed payment rescue.
  rescueCode              String?         @unique // tradesura.com/u/{code}
  paymentRecoveredAt      DateTime?
  passportId              String?
  passport                HomePassport?   @relation(fields: [passportId], references: [id])
  cancellations           CancelRequest[]
  ratings                 Rating[]
  // LAW (plan wording is locked) — the tier as the customer agreed it,
  // snapshotted at tier-selection. Reads of the agreed contract (plan
  // document, portal "what's included", CP12 reminder logic) resolve through
  // lib/plan-tier.ts and prefer this, so editing the live tier never rewrites
  // an existing agreement. Null for plans created before this column.
  agreedTier              Json?
  priceReviews            PriceReview[]
  // Section 8 — staff engineer who made the sale ("signed up by"); null = owner.
  soldById                String?
  soldBy                  Engineer?       @relation("PlanSoldBy", fields: [soldById], references: [id])
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}

// Signup phone codes (30 Sept build notes, step 1 item 15): a code works
// once, expires after 10 minutes, and 5 wrong tries block the number for 15
// minutes. Only the code's hash is stored.
model PhoneOtp {
  id          String    @id @default(cuid())
  phone       String // E.164
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  usedAt      DateTime?
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
}

// Sign-in codes (4 Oct build notes, section 2): email (text once SMS is
// live) → 6-digit code → signed in. Same rules as PhoneOtp: 10-minute life,
// single use, 5 wrong tries block the account for 15 minutes. Hash only.
model SignInCode {
  id          String    @id @default(cuid())
  engineerId  String
  channel     String // email | sms
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  usedAt      DateTime?
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())

  @@index([engineerId, createdAt])
}

model GasSafeRecord {
  regNo      String @id // normalised: digits only
  name       String
  company    String
  categories String
  // QA-07: only when the register file has them (scripts/import-gas-safe.ts):
  // the business address, and the licence card's expiry, set beside what the
  // engineer gave on the admin's check page.
  address       String?
  postcode      String?
  cardExpiresOn DateTime? @db.Date
}

// Analytics + audit, append-only.
model Event {
  id        String    @id @default(cuid())
  name      String
  actorType ActorType
  actorId   String?
  meta      Json?
  ts        DateTime  @default(now())

  @@index([name, ts])
}

// Quiet-hours queue + abandon nudges.
model OutboundSms {
  id           String       @id @default(cuid())
  engineerId   String
  toPhone      String
  senderName   String // trading name
  body         String
  class        MessageClass
  status       SmsStatus    @default(QUEUED)
  sendAfter    DateTime
  cancelKey    String? // e.g. "nudge:<planId>" — cancelled on activation
  // plan-member-transactional | engineer-initiated | marketing
  consentBasis String?
  sentAt       DateTime?
  // What happened to it (QA-02): Twilio's message ID once it took the text,
  // then its delivery receipt (app/api/webhooks/sms-status). failedAt is set
  // when Twilio refused it, texts weren't set up, or the network couldn't
  // deliver it; failureReason says which (or Twilio's error code).
  providerSid   String?   @unique
  deliveredAt   DateTime?
  failedAt      DateTime?
  failureReason String?

  @@index([status, sendAfter])
}

// One cross-channel opt-out store (CLAUDE.md §Compliance 5): STOP/unsubscribe
// writes here, every send path checks it. Kept alongside Customer.smsOptOut
// (which stays as the per-engineer-book flag surfaced in the UI).
model Suppression {
  channel   String // sms | email
  value     String // normalised E.164 phone or lowercased email
  source    String // sms_stop | unsubscribe_link | manual
  createdAt DateTime @default(now())

  @@id([channel, value])
}

// Letter-campaign claim codes (C5). One row per letter recipient; the split
// test's variant cell is the attribution that must survive to the account.
model ClaimCode {
  code                  String    @id // e.g. TS-48217 (normalised: upper, no spaces)
  firstName             String
  businessName          String
  letterBatch           String
  variantCell           String // A | B | C | D
  suppressedAt          DateTime? // opted out — resolve to the generic path
  redeemedByEngineerId  String?   @unique
  redeemedAt            DateTime?
  createdAt             DateTime  @default(now())
  // 30 Oct update §1 — the claim page (tradesura.com/c/CODE). `town` is the
  // one printed on the letter; the rest is what they confirm there, which
  // the app shows back at sign-up (never our list data).
  town                  String?
  claimedAt             DateTime? // "Confirm your details" done: Founding spot reserved
  tradingAddress        String? // "line1\ntown\npostcode"
  tradingTown           String? // their home town, from the trading address
  tradingTownSlug       String?
  correspondenceAddress String? // "Send my post somewhere else"; null = trading address
  mobile                String? // E.164
  textConsentAt         DateTime? // "TradeSura can text me to help me finish setting up."
  codeTextedAt          DateTime?
}

// 30 Oct update §10 — a Founding Member's top-3 spot in their town. The
// first 3 Founding Members in a town to complete their account hold one;
// released after 60 days without a customer, then it passes to the next to
// complete. One open row per engineer.
model TopSpot {
  id            String    @id @default(cuid())
  townSlug      String
  engineerId    String
  heldFrom      DateTime  @default(now())
  releasedAt    DateTime?
  releaseReason String? // no_customer | left_town | account_closed
  createdAt     DateTime  @default(now())

  @@index([townSlug, releasedAt])
  @@index([engineerId])
}

// Stripe webhook idempotency guard.
model StripeWebhookEvent {
  id          String   @id // Stripe event id (evt_…)
  type        String
  payload     Json
  processedAt DateTime @default(now())
}

// Build Review 2, ruling 4 — every installer is an affiliate: 25% of
// TradeSura's fee on plans sold by engineers they bring in, for that
// engineer's first 12 months, then 10% for life. One level only. One row per
// paid customer invoice; invoiceId makes the webhook safe to replay.
model ReferralEarning {
  id          String   @id @default(cuid())
  referrerId  String
  referrer    Engineer @relation("ReferralEarnings", fields: [referrerId], references: [id])
  inviteeId   String
  invitee     Engineer @relation("ReferredEarnings", fields: [inviteeId], references: [id])
  invoiceId   String   @unique
  feePence    Int // TradeSura's 20% on that invoice
  ratePercent Int // 25 in the invitee's first 12 months, then 10
  amountPence Int
  transferId  String? // Stripe transfer to the referrer, once sent
  createdAt   DateTime @default(now())

  @@index([referrerId, createdAt])
}

// Build Review 2, ruling 3 — annual price review for existing customers. At
// most once a year per plan, 30 days' notice by text and email with the old
// price, new price, start date and a free cancel link. Applied on
// effectiveAt by the daily job (lib/price-review.ts).
model PriceReview {
  id           String    @id @default(cuid())
  planId       String
  plan         Plan      @relation(fields: [planId], references: [id])
  oldPence     Int
  newPence     Int
  noticeSentAt DateTime  @default(now())
  effectiveAt  DateTime
  appliedAt    DateTime?
  voidedAt     DateTime? // plan ended before the new price started

  @@index([planId])
  @@index([effectiveAt])
}

// ---------------------------------------------------------------------------
// Retention, Home Passport & Growth (Matt Wood, 15 Oct 2026)
// ---------------------------------------------------------------------------

// Section 2 — every cancel attempt, its reason, the offer shown and how it
// ended. Feeds the installer and admin dashboards.
model CancelRequest {
  id              String    @id @default(cuid())
  planId          String
  plan            Plan      @relation(fields: [planId], references: [id])
  engineerId      String
  // too_expensive | moving | not_using | unhappy | other
  reason          String
  detail          String?
  offer           String? // cheaper_plan | move_plan | show_value | pause
  // pending | saved | paused | downgraded | cancelled
  outcome         String    @default("pending")
  source          String    @default("customer") // customer | engineer_logged
  // Moving house: date, and consent to pass the passport to the next owner.
  moveDate        DateTime?
  passportConsent Boolean?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([engineerId, createdAt])
}

// Section 4 — one passport per address; belongs to the home, not the person.
model HomePassport {
  id               String          @id @default(cuid())
  // Normalised postcode + first address line — how a second plan at the
  // same address finds the same passport.
  addressKey       String          @unique
  uprn             String?
  addressLine1     String
  town             String?
  postcode         String
  // Homeowner's private link to view/download the whole history.
  viewToken        String          @unique
  // Consent to be contacted about leads from the passport (privacy notice).
  contactConsentAt DateTime?
  createdAt        DateTime        @default(now())
  properties       Property[]
  appliances       Appliance[]
  records          ServiceRecord[]
  plans            Plan[]
  stickers         Sticker[]
}

// A dated entry on a passport: a service, certificate, install or note.
// Engineers see only their own; the homeowner sees everything.
model ServiceRecord {
  id          String       @id @default(cuid())
  passportId  String
  passport    HomePassport @relation(fields: [passportId], references: [id])
  applianceId String?
  appliance   Appliance?   @relation(fields: [applianceId], references: [id])
  engineerId  String
  engineer    Engineer     @relation(fields: [engineerId], references: [id])
  planId      String?
  kind        String // service | certificate | install | note
  doneAt      DateTime
  notes       String?
  photoUrls   String[]     @default([])
  nextDueAt   DateTime?
  createdAt   DateTime     @default(now())
  rating      Rating?

  @@index([passportId, doneAt])
}

// Pre-printed boiler stickers: unique code, no address. Allocated to an
// engineer in the member pack; linked to a passport at the job.
model Sticker {
  code       String        @id // e.g. HX4K-7Q
  engineerId String?
  engineer   Engineer?     @relation("StickerAllocated", fields: [engineerId], references: [id])
  passportId String?
  passport   HomePassport? @relation(fields: [passportId], references: [id])
  linkedAt   DateTime?
  scans      Int           @default(0)
  createdAt  DateTime      @default(now())
}

// Section 5 — one rating per logged service, plan holders only. Never
// filtered; removed only for clear abuse with a logged reason.
model Rating {
  id              String        @id @default(cuid())
  engineerId      String
  engineer        Engineer      @relation(fields: [engineerId], references: [id])
  // A service rating has a plan and a logged service; an at-the-job review
  // (30 Oct update §6, "plans first, then the review") may have neither.
  planId          String?
  plan            Plan?          @relation(fields: [planId], references: [id], onDelete: Restrict)
  serviceRecordId String?        @unique
  serviceRecord   ServiceRecord? @relation(fields: [serviceRecordId], references: [id], onDelete: Restrict)
  source          String         @default("service") // service | offer
  offerSessionId  String?        @unique
  contactPhone    String? // E.164, verified by a text code (non-joiners)
  contactEmail    String? // verified by an emailed code (non-joiners)
  // "[Business] may send you occasional plan offers" — ticked by default.
  offerConsent    Boolean        @default(false)
  requestToken    String        @unique
  stars           Int?
  comment         String?
  customerName    String? // first name + initial, shown publicly
  ratedAt         DateTime?
  reply           String?
  repliedAt       DateTime?
  removedAt       DateTime?
  removedReason   String?
  createdAt       DateTime      @default(now())

  @@index([engineerId, ratedAt])
}

// 30 Oct update §7.7 — "Send me the details" on the customer plan page: a
// customer thinking about it leaves a name and mobile (with consent) and gets
// the plan link again at 2 and 7 days. joinedAt stops the follow-ups.
model DetailsRequest {
  id         String    @id @default(cuid())
  engineerId String
  engineer   Engineer  @relation(fields: [engineerId], references: [id])
  tierId     String?
  name       String
  phone      String // normalised E.164
  consentAt  DateTime
  source     String? // web | demo | website | …
  joinedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([engineerId, createdAt])
  @@index([phone])
}

// Section 6 — Call taps and Message forms from public profiles.
model Enquiry {
  id         String   @id @default(cuid())
  engineerId String
  engineer   Engineer @relation(fields: [engineerId], references: [id])
  kind       String // call | message
  name       String?
  phone      String?
  email      String?
  message    String?
  source     String? // profile | town | widget
  createdAt  DateTime @default(now())

  @@index([engineerId, createdAt])
}

// 30 Oct update §10 — a homeowner's request from a town page, not addressed
// to any one engineer. Founding Members in the town get first pick until
// foundingUntil; then it opens to every listed engineer there. The first to
// claim it gets the contact details (as an Enquiry in their app).
model TownLead {
  id            String    @id @default(cuid())
  townSlug      String
  name          String
  phone         String?
  email         String?
  postcode      String
  message       String
  // The homeowner ticked "Pass my details to one local engineer on TradeSura…".
  consentAt     DateTime
  emergency     String? // interlock keyword they acknowledged, if any
  foundingUntil DateTime
  openedAt      DateTime? // set when it opens to everyone in the town
  claimedById   String?
  claimedBy     Engineer? @relation("TownLeadClaims", fields: [claimedById], references: [id])
  claimedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([townSlug, claimedAt])
  @@index([claimedById])
}

// Section 6 — a town page publishes only once it has real engineers; admin
// can hold one back.
model TownPage {
  slug        String    @id // huddersfield
  name        String
  heldAt      DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

// Notes TradeSura staff keep about an engineer or customer, written through
// the admin API. Never shown to the engineer or customer. The author is the
// admin app's user (no Engineer row), so there's no foreign key.
model AdminNote {
  id          String    @id @default(cuid())
  subjectType String // engineer | customer
  subjectId   String
  body        String
  authorId    String
  authorName  String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([subjectType, subjectId, createdAt])
}

// Who is checking a waiting Gas Safe application in the admin app. A claim
// lasts 15 minutes from the last refresh; while someone else holds a fresh
// one, the application can't be decided (lib/admin/verifications.ts).
model VerificationClaim {
  engineerId String   @id
  adminId    String
  adminName  String
  claimedAt  DateTime @default(now())
}

// Engineers and customers TradeSura staff have marked as test data in the
// admin app. Every admin figure leaves them out, with their offers and
// payments (lib/admin/metrics.ts); lists label them TEST. A judgement made in
// the admin, so it lives here rather than on the app's own tables.
model AdminTestMark {
  subjectType String // engineer | customer
  subjectId   String
  adminId     String
  adminName   String
  reason      String?
  createdAt   DateTime @default(now())

  @@id([subjectType, subjectId])
}

// Section 10 — admin-set numbers (e.g. "New to TradeSura" rating count,
// cancel-rate flag threshold, sticker low-stock level).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// 30 Oct update §6 — the per-reason content the customer screens are
// tailored with. Muhammad's admin writes these rows; with none for a reason
// the defaults in lib/visit-reasons.ts apply. Several rows per reason with
// different `variant`s are a split test, weighted by `weight`.
model VisitReasonContent {
  id           String   @id @default(cuid())
  reason       String // new_boiler | breakdown | yearly_service | landlord | other (or a new key)
  variant      String   @default("A")
  weight       Int      @default(1)
  active       Boolean  @default(true)
  label        String // the installer's one-tap button, e.g. "New boiler fitted"
  sortOrder    Int      @default(0)
  headline     String
  worries      Json // string[] — the customer's likely worries
  messages     Json // string[] — the answers, in order
  graphicKey   String?
  benefitOrder Json // string[] of clause codes, most relevant first
  preselect    String   @default("middle") // first | middle | top | landlord
  followUp2d   String // text 2 days later; {first}, {engineer}, {link}
  followUp7d   String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([reason, variant])
}

// One at-the-job offer: the reason picked, and whether the customer joined
// there and then ("Show them now") — the review afterwards hangs off it.
model OfferSession {
  id         String   @id @default(cuid())
  token      String   @unique
  engineerId String
  soldById   String?
  reason     String
  variant    String   @default("A")
  channel    String // show | sms | whatsapp
  planId     String?  @unique
  createdAt  DateTime @default(now())

  @@index([engineerId, createdAt])
}

// An engineer's trading address: where they work from. It sets their town and
// town page (Engineer.town, townSlug and postcode follow it). Correspondence
// stays Engineer.packAddress, where the member pack and all post go; it's
// "the same as trading" while the two match. The registered office comes
// from Companies House and is for legal details only. Written by the admin
// API (and copied from sign-up by scripts/admin-copy-addresses.ts) until
// sign-up writes it.
model EngineerTradingAddress {
  engineerId    String   @id
  lines         String[] // street lines, without the town and postcode
  town          String
  postcode      String // normalised, as lib/validate.ts normalisePostcode
  source        String // signup | admin
  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
