DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
APP_URL="http://localhost:3000"
# Quiet-hours SMS logic (lib/sms.ts) reads the server's local clock — pin
# this everywhere (including Vercel's env vars) so it doesn't drift once
# the app isn't running on a UK machine.
TZ="Europe/London"
SESSION_SECRET="generate-a-long-random-string"
# Stripe — TEST MODE ONLY. lib/stripe.ts hard-refuses any key that isn't
# sk_test_… ; go-live is a human sign-off, not a config change. Provisioned
# via the Vercel Marketplace (`vercel integration add stripe`).
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Two SEPARATE webhook endpoint objects point at <APP_URL>/api/stripe/webhook
# — Stripe can't combine platform and Connect event scopes on one endpoint
# (docs.stripe.com/connect/webhooks). Each has its own signing secret.
# 1) "Your account" scope (checkout, invoices, subscriptions):
STRIPE_WEBHOOK_SECRET="whsec_..."
# 2) "Connected accounts" scope (account.updated) — created with connect:true
# via the API, or the "Listen to events on Connected accounts" toggle in the
# dashboard:
STRIPE_WEBHOOK_SECRET_CONNECT="whsec_..."
# In local dev, run both listeners from the Stripe CLI in separate terminals:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
#   stripe listen --forward-connect-to localhost:3000/api/stripe/webhook
# lib/sms.ts falls back to a console.log dev driver when any of these three
# are unset — leave them blank locally unless you're testing real sends.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# The shared long code used for the OTP code and as the only number that can
# receive inbound STOP replies (app/api/webhooks/sms-inbound) — engineer-
# branded marketing/transactional texts send from an alphanumeric sender
# derived from their trading name instead, per CLAUDE.md §Compliance 5.
TWILIO_SMS_NUMBER=""
# Signup step 3's "Find your company" lookup (app/api/onboarding/companies).
# Free key from developer.company-information.service.gov.uk. Unset → the
# app falls back to typing the company number by hand.
COMPANIES_HOUSE_API_KEY=""
# lib/email.ts falls back to a console.log dev driver when this is unset.
# Same provider as epc-builder/improveasy-app. Get a key at resend.com —
# works immediately from onboarding@resend.dev with no setup; to send from
# a TradeSura address, verify a domain in the Resend dashboard first and
# set RESEND_FROM_EMAIL to match.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TradeSura <onboarding@resend.dev>"
# Vercel Cron's bearer for GET /api/jobs/flush-sms (vercel.json). Any long
# random string; Vercel sends it automatically once set in the project.
CRON_SECRET=""
# Opens the Gas Safe review queue: /admin/verifications?key=<ADMIN_SECRET>.
ADMIN_SECRET=""
# Sign-in codes (4 Oct notes §2). "off" = instant email sign-in — ONLY while
# email can't be delivered yet (Resend domain unverified). Remove before any
# pilot engineer gets access.
SIGNIN_CODES=""
# Admin API (/api/admin/v1, lib/admin-api) for the separate TradeSura Admin app.
# The admin app signs every call with this; set the same value there as
# TRADESURA_ADMIN_API_SECRET. 32+ random characters, and NOT the same as
# SESSION_SECRET. Unset = every admin API call answers 503.
ADMIN_API_SECRET=""
# Only while changing that secret: tokens signed with this are accepted too.
# Set the new secret here, move the admin app onto it, then make it
# ADMIN_API_SECRET and clear this.
ADMIN_API_SECRET_NEXT=""
# Local demos only: extra origins the admin API may fetch ID-card photos from
# besides Vercel Blob, e.g. the docker-compose demo-blob service:
#   ADMIN_CARD_EXTRA_ORIGINS="http://127.0.0.1:54321"
ADMIN_CARD_EXTRA_ORIGINS=""
